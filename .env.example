POSTGRES_DB=judgeguard
POSTGRES_USER=judgeguard
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://judgeguard:change-me-locally@postgres:5432/judgeguard

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000/api/v1

SESSION_COOKIE_NAME=judgeguard_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SIGNING_SECRET=replace-with-at-least-32-random-characters

# Public voting / abuse controls
VOTE_RATE_LIMIT=30
VOTE_RATE_WINDOW_SECONDS=60
COMMENT_RATE_LIMIT=10
COMMENT_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
PUBLIC_VOTER_COOKIE_NAME=judgeguard_voter

# Webhook security
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
